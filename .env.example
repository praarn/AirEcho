# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=aq
POSTGRES_PASSWORD=aq
POSTGRES_DB=aq
# inside docker compose the host is "db"; running locally use "localhost"
DATABASE_URL=postgresql+psycopg://aq:aq@db:5432/aq

# ─── Auth ──────────────────────────────────────────────────────────────────
# generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-output-of-the-command-above
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ─── LLM (advisory rephrasing only — never lets the model invent thresholds) ──
# OpenAI-compatible or Anthropic. Leave blank to use the deterministic
# template renderer (tests always mock this; the app degrades gracefully).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ─── Ingestion ─────────────────────────────────────────────────────────────
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENWEATHER_API_KEY=
# master switch for the in-process scheduler; tests set this to false
SCHEDULER_ENABLED=true
INGEST_INTERVAL_MINUTES=20
# when true (and no OPENAQ key/network), the scheduler emits synthetic gappy
# readings so the pipeline has something to chew on in a demo
SYNTHETIC_INGEST=true

# ─── Frontend ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
